# ─── متغیرهای Railway (۱۲ مورد) ───────────────────────────────
# Railway این فایل را از ریشه‌ی ریپو می‌خواند و هر ۱۲ مورد را با مقدار
# موقع ساختِ سرویس پیشنهاد می‌دهد.
# هشدار: اینجا فقط مقدارِ نمونه بذار. مقدارهای واقعی رو توی Railway > Variables ست کن، نه توی ریپو.

BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=your_bot_username

PISHVA_ID=your_telegram_numeric_id
PISHVA_USERNAME=@your_username
PISHVA_PASSWORD=change_me
NEW_YEAR_PASSWORD=change_me
PRINCIPAL_KEY=change_me

GEMINI_API_KEY=your_gemini_api_key

DB_PATH=chess_bot.db
TURSO_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
TURSO_FORCE_HTTP=1

# ─── اختیاری (لازم نیست) ───
# HUB_URL=https://your-app.up.railway.app/hub/
# HUB_BUTTON_TEXT=CMS
# اگر هیچ‌کدام ست نباشد، از RAILWAY_PUBLIC_DOMAIN استفاده می‌شود.
# WEBAPP_URL را از پروژه‌ی قدیمی کپی نکنید.
